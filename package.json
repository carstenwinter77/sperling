{
  "name": "sperling",
  "version": "0.9.5",
  "private": true,
  "description": "Sperling – Außendienst-PWA für Photovoltaik, Wärmepumpe und Vorwerk",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8765",
    "build": "vite build",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "start": "vite preview --port 8765 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.cjs && node tests/e2e-faceid.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
